# shinyApp(ui = ui, server = server)
ui <- fluidPage(
  titlePanel("Statistics Word Search"),
  sidebarLayout(
    sidebarPanel(
      actionButton("new", "Generate New Game"),
      numericInput("row",   "Start row:",   value = 1, min = 1),
      numericInput("col",   "Start col:",   value = 1, min = 1),
      selectInput("dir",    "Direction:",   choices = c("Horizontal" = "horizontal", "Vertical" = "vertical")),
      textInput("guess",    "Word guess:",  ""),
      actionButton("check", "Check"),
      verbatimTextOutput("msg")
    ),
    mainPanel(
      uiOutput("grid"),
      h4("Found words: "),
      uiOutput("foundWordsList")
    )
  )
)
server <- function(input, output, session) {
  # stores current grid
  gridData <- reactiveVal(generate_grid(vocab, grid_size = 20, num_word = 10))
  
  #stores found word location
  foundCells <- reactiveVal(data.frame(row = integer(), col = integer()))
  
  #stores found word
  foundWords <- reactiveVal(character())
  
  # generate on app start and whenever you click “Generate New Game”
  observeEvent(input$new, {
    gridData(generate_grid(vocab, grid_size = 20, num_word = 10))
    foundCells(data.frame(row = integer(), col = integer()))
    foundWords(character())
    output$msg <- renderText("")  
  })
  
  # check if word exists whenever you click "Check"
  
  observeEvent(input$check, {
    word <- toupper(input$guess)
    info <- gridData()$word_placement[[word]]
    #check if word exist
    if(is.null(info)){
      output$msg <- renderText("This Word does not exist!")
      return()
    }
    if(input$row == info$row & input$col == info$col & input$dir == info$direction){
      output$msg <- renderText("Correct!")
      L <- nchar(word)
      coords <- if (info$direction=="horizontal") {
        data.frame(row=rep(info$row,L), col=info$col + seq_len(L)-1)
      } else {
        data.frame(row=info$row + seq_len(L)-1, col=rep(info$col,L))
      }
      # update foundCells
      fc     <- foundCells()
      new_fc <- unique(rbind(fc, coords))
      foundCells(new_fc)
      
      # update foundWords (avoid duplicates)
      fw <- foundWords()
      if (! word %in% fw) {
        foundWords(c(fw, word))
      }
    }
    
  })
  
  output$grid <- renderUI({
    mat <- gridData()$grid
    fc  <- foundCells()
    nr  <- nrow(mat)
    nc <- ncol(mat)
    
    tags$table(

      # 1) Column headers
      tags$tr(
        tags$th("", style="width:30px; border:none;"), # so that label doesn't start at corner
        # column header
        lapply(seq_len(nc), function(c) {
          tags$th(c)
        })
      ),
      
      # 2) Data rows
      lapply(seq_len(nr), function(r) {
        tags$tr(
          # row header
          tags$th(r),
          # the letter cells
          lapply(seq_len(nc), function(c) {
            found <- any(fc$row == r & fc$col == c)
            tags$td(
              mat[r, c],
              style = paste(
                "width:25px; height:25px; text-align:center; ",
                "border:1px solid #999; ",
                if (found) "background-color: yellow;" else ""
              )
            )
          })
        )
      })
    )
  })
  output$foundWordsList <- renderUI({
    fw <- foundWords()
    tags$ul(
      lapply(fw, function(w) tags$li(w))
    )
  })
  
}

shinyApp(ui, server)
